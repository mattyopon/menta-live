# ───────────────────────────────────────────────────────────────────────────
# Mentra AWS Quiz — environment template
# Copy to `.env` and fill in. `.env` is gitignored; NEVER commit real keys.
# ───────────────────────────────────────────────────────────────────────────

# --- MentraOS app credentials (from console.mentraglass.com) ---
# The package name you registered in the developer console (reverse-domain).
PACKAGE_NAME=com.mattyopon.awsquiz
# API key generated for that app in the console.
MENTRA_API_KEY=

# Port your AppServer listens on. Must match the public URL you registered
# (via ngrok/Cloudflare tunnel) in the console.
PORT=3000

# --- Vision backend selection ---
# http   = call the existing FastAPI /vision/session (default; the faithful port,
#          reuses the Python brain: dedup, auth modes, AWS-knowledge MCP grounding)
# direct = call Anthropic Vision directly from this Node process (no FastAPI).
#          Requires ANTHROPIC_API_KEY below. max_sub auth is NOT supported in direct mode.
VISION_BACKEND=http

# Base URL of the /vision/session backend (only used when VISION_BACKEND=http).
# Examples:
#   http://localhost:8080          (backend on same host)
#   http://100.x.y.z:8080          (Tailscale IP)
VISION_BACKEND_URL=http://localhost:8080

# --- direct mode only (VISION_BACKEND=direct) ---
# Anthropic API key. Per-call billing (ToS-clean).
ANTHROPIC_API_KEY=
# Model ids per tier (override the defaults below if you want to pin specific snapshots).
ANTHROPIC_OPUS_MODEL=claude-opus-4-8
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
# Max output tokens for the answer (symbols only, so small is fine). Bumped to 2048 under MCP.
VISION_MAX_TOKENS=200
# Attach the AWS Knowledge MCP server to the opus path for fact-grounded answers (1 = on).
ENABLE_AWS_KNOWLEDGE_MCP=0
AWS_KNOWLEDGE_MCP_URL=https://knowledge-mcp.global.api.aws

# Which inference model the backend should use: haiku | sonnet | opus
# (opus = highest accuracy + AWS-knowledge MCP grounding when api_key auth).
DEFAULT_INFERENCE_MODE=opus

# Backend auth path: api_key (ToS-clean, per-call billing) | max_sub (opt-in,
# ToS-risk OAuth reuse). See rokid-glass-day1 README before using max_sub.
DEFAULT_AUTH_MODE=api_key

# Default exam when the user hasn't picked one yet (CLF/SAA/SAP/... see examPrompts).
DEFAULT_EXAM_CODE=SAA

# After a successful answer, auto-capture the next frame this many ms later.
# 0 = manual only (press the button for each question). Mirrors AUTO_LOOP_DELAY_MS.
AUTO_LOOP_DELAY_MS=0

# --- Audio latency feedback (display-less UX) ---
# Spoken immediately on button press so you know it registered (set "off" to disable).
CAPTURE_CUE_TEXT=はい
# Spoken once if the answer is still not back after SLOW_CUE_AFTER_MS ("off" to disable).
SLOW_CUE_TEXT=確認中です
# Delay before the slow cue (ms). 0 disables it.
SLOW_CUE_AFTER_MS=3500

# Speak a "(answered with Haiku)" note when a requested opus/sonnet call was rate-limited
# down to haiku (a lower-confidence signal). 1/unset = on, 0 = off.
ANNOUNCE_FALLBACK=1

# --- External trigger (e.g. Rokid Ring via phone automation) ---
# Shared secret that enables POST /ext/trigger. Leave blank to NOT expose the endpoint.
# When set, a phone automation (Tasker/MacroDroid) mapped to the ring's button can fire:
#   curl -X POST "https://<your-ngrok>/ext/trigger?user=<userId>&action=capture" \
#        -H "x-trigger-token: <this value>"
# Allowed actions: capture | toggleMode | repeat | cost | diagnostics
RING_TRIGGER_TOKEN=

# Optional: ElevenLabs voice id for TTS (leave blank for server default).
# If Japanese sounds unnatural, set a multilingual/Japanese voice id here.
TTS_VOICE_ID=
# Transcription language passed to onTranscriptionForLanguage.
TRANSCRIBE_LANGUAGE=ja-JP
